# Ket noi PostgreSQL (>= 13)
DATABASE_URL=postgres://postgres:matkhau@127.0.0.1:5432/poteco

# Cong lang nghe
PORT=4000

# BAT BUOC o moi truong that: chuoi ngau nhien dai >= 32 ky tu
JWT_SECRET=

# Thoi han token (giay). Access token ngan, refresh token dai.
JWT_TTL_GIAY=3600
REFRESH_TTL_NGAY=30

# Danh sach origin duoc phep goi API tu trinh duyet, cach nhau dau phay.
# De trong = khong cho phep origin nao (Android khong can CORS).
CORS_ORIGINS=http://localhost:3000

# 1 = tu dong don nhat ky quá han moi 24 gio
DON_NHAT_KY_TU_DONG=1

# Dang nhap sai: so lan toi da va thoi gian khoa (phut) theo cap tai khoan + IP
DANG_NHAP_SAI_TOI_DA=5
DANG_NHAP_KHOA_PHUT=15

# Dat khi chay sau reverse proxy (so tang proxy hoac 'loopback'), de gioi han dang nhap sai theo dung IP khach
# TRUST_PROXY=1

# Tien to URL mount API (cach nhau dau phay). Mac dinh /api/v1.
# Sau reverse proxy https://ticketforge.vietdemo.com/api_poteco: neu proxy CAT tien to dat "/", neu KHONG cat dat "/api_poteco".
# Dat ca hai cho chac: API_PREFIX=/api/v1,/api_poteco,/
# API_PREFIX=/api/v1
